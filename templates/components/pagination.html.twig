<div class="flex justify-center w-full">
    <nav aria-label="Pagination" style="width: 25%;display: flex;justify-content: center;">
        <ul class="font-semibold text-lg w-full h-12 pagination border-2 rounded-lg" style="display: flex; justify-content: space-between;">
            <li class="page-item {{ currentPage == 1 ? 'cursor-no-drop' }}">
                <a class="page-link" href="{{ path(route, { page: currentPage - 1 }) }}" aria-label="Previous">
                    <span aria-hidden="true"><</span>
                    <span class="sr-only">Page précédente</span>
                </a>
            </li>

            {% set availablePages = countPages > 3 ? 3 : countPages %}

            {% if currentPage <= 2 %}
                {% for i in range(1, 2) %}
                    <li class="page-item {{ currentPage == i ? 'active' }}"><a class="page-link" href="{{ path(route, { page: i }) }}">{{ i }}</a></li>
                {% endfor %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
                <li class="page-item"><a class="page-link" href="{{ path(route, { page: countPages - 1 }) }}">{{ countPages - 1 }}</a></li>
                <li class="page-item"><a class="page-link" href="{{ path(route, { page: countPages }) }}">{{ countPages }}</a></li>

            {% elseif currentPage >= countPages - 1 %}
                <li class="page-item"><a class="page-link" href="{{ path(route, { page: 1 }) }}">1</a></li>
                <li class="page-item disabled"><span class="page-link">...</span></li>
                {% for i in range(countPages - 2, countPages) %}
                    <li class="page-item {{ currentPage == i ? 'active' }}"><a class="page-link" href="{{ path(route, { page: i }) }}">{{ i }}</a></li>
                {% endfor %}

            {% else %}
                <li class="page-item"><a class="page-link" href="{{ path(route, { page: 1 }) }}">1</a></li>
                <li class="page-item active"><a class="page-link" href="{{ path(route, { page: currentPage }) }}">{{ currentPage }}</a></li>
                <li class="page-item disabled"><span class="page-link">...</span></li>
                <li class="page-item"><a class="page-link" href="{{ path(route, { page: currentPage + 1 }) }}">{{ currentPage + 1 }}</a></li>
                <li class="page-item"><a class="page-link" href="{{ path(route, { page: countPages }) }}">{{ countPages }}</a></li>
            {% endif %}

            {% if currentPage < countPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path(route, { page: currentPage + 1 }) }}" aria-label="Next">
                        <span class="sr-only">Page suivante</span>
                        <span aria-hidden="true">></span>
                    </a>
                </li>
            {% endif %}
        </ul>
    </nav>
</div>