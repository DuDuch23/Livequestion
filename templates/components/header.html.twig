<header class="p-10 flex justify-between">
    <a href="#" class="font-['playfair'] items-center flex livequestion">
        Livequestion
    </a>
    <nav class="nav-list flex items-center w-3/5">
        <ul class="flex">
            <li class="nav-item text-xl">
                <a class=" p-5" href="{{ path('home') }}">
                    Accueil
                </a>
            </li>
            {% if app.user != false %}
            <li class="nav-item text-xl">
                <a class=" p-5" href="{{ path('question') }}">
                    Les questions
                </a>
            </li>
            <li class="nav-item text-xl">
                <a class=" p-5" href="{{ path('auteur') }}">
                    Les auteurs
                </a>
            </li>
            <li class="nav-item text-xl">
                <a class=" p-5" href="{{ path('new_question') }}">
                    Nouvelle question
                </a>
            </li>
            {% endif %}
        </ul>
    </nav>
    {% if app.user %}
        <div class="flex items-center">
            <a href="{{ path('mon_profil', { 'username' : app.user.username }) }}" class="flex items-center gap-4">
                <img class="image_user w-16 h-16 rounded-full" src="{{ vich_uploader_asset(app.user, 'imageFileUser') }}">
                <p class="font-semibold text-xl">{{ app.user.userIdentifier }}</p>
            </a>
        </div>
        <div class="flex items-center">
            <a class="w-6 h-6" href="{{ path('logout') }}">
                <img src="{{ asset('media/deconnexion.png') }}">
            </a>
        </div>
    {% else %}
    {% if app.request.attributes.get('_route') != 'inscription' %}
        <form action="{{ path('home') }}" method="post">
            <div class="container-username grid">
                <label for="username">Nom d'utilisateur</label>
                <input class="text-black" type="text" value="{{ last_username }}" name="_username" id="username">
            </div>
            <div class="container-password grid">
                <label for="password">Password</label>
                <input class="text-black" type="password" name="_password" id="password">
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            {#
                Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                See https://symfony.com/doc/current/security/remember_me.html

                <div class="checkbox mb-3">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me">Remember me</label>
                </div>
            #}

            <button class="btn btn-lg btn-primary" type="submit">
                Sign in
            </button>
        </form>
        <a class=" p-5" href="{{ path('inscription') }}">
            s'inscrire
        </a>
    {% endif %}
    {% endif %}

    {% set routeName = app.request.attributes.get('_route') %}
        
    {% if routeName == 'home' %}
        {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
    {% endif %}
    
</header>
