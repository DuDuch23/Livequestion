<div class="question w-full flex">
    <a href="{{ path('reponse', {id: question.id}) }}" method="get">
        <div class="flex">
            {% if question.imageNameQuestion == null %}
                <img class="image_last_question rounded-2xl w-3/5 max-w-72" src="{{ asset('media/image_question_default.jfif') }}">
            {% else %}
                <img class="image_last_question rounded-2xl w-3/5 max-w-72" src="{{ vich_uploader_asset(question, 'imageFileQuestion') }}">        
            {% endif %}
            <div class="grid ml-12">
                <div class="flex gap-4 items-center">
                    <p class="font-bold text-base">{{ question.thematicId.name }}</p>
                    <span>•</span>
                    <p class="text-base">Il y a {{ question.getTimeElapsed() }}</p>
                </div>
                <h1 class="font-semibold text-lg">{{ question.title }}</h1>
                {% include "components/createdByAndNbAnswerLittleFont.html.twig" %}
            </div>
        </div>
    </a>
    {% if app.request.attributes.get('_route') == 'mon_profil' %}
    <form action="{{ path('modifier_ma_question', {id: question.id}) }}" method="get">
        <button type="submit">
            <span>Modifier</span>
        </button>
    </form>
    {% endif %}
</div>