{% extends 'base.html.twig' %}

{% block title %}Livequestion - Auteur {{ user.username }}{% endblock %}

{% block body %}
    {% include "components/header.html.twig" %}
    <div class="m-12">
        <div class="container-profil flex justify-around mb-28">
            <div class="grid justify-center items-center">
                <p>Nombres de question publiée : {{ countQuestion }}</p>
                <p>Rang de l'utilisateur :</p>
            </div>
            <div class="grid">
                <div class="flex justify-center items-center">
                    {% if user.imageNameUser == null %}
                        <img class="shadow-xl image_user_profil w-40 h-40 rounded-full" src="{{ asset('media/pdp_default.jpg') }}">
                    {% else %}
                        <img class="shadow-xl image_user_profil w-40 h-40 rounded-full" src="{{ vich_uploader_asset(user, 'imageFileUser') }}">        
                    {% endif %}
                </div>
                <h1 class="font-semibold text-4xl mb-4 mt-4 text-center">{{ user.username }}</h1>
            </div>
        </div>
        <ul class="gap-16 grid">
            {% for question in questions %}
                {% include "components/question.html.twig" %}
            {% else %}
                <li>Aucune question trouvée.</li>
            {% endfor %}
        </ul>

        {% include "components/footer.html.twig" %}
    </div>
{% endblock %}