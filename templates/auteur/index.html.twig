{% extends 'base.html.twig' %}

{% block title %}Livequestion - Auteurs{% endblock %}

{% block body %}
    {% include "components/header.html.twig" %}
    <div class="m-12">
        <h1 class="font-semibold text-4xl mb-12">Les auteurs</h1>
        <section class="container-author grid grid-cols-6 gap-10">
            {% for user in users %}
                <a href="{{ path('profil_auteur', { 'id' : user.id }) }}">
                    <div class="flex justify-between border-2 rounded-lg p-1">
                        <p class="items-center flex ">{{ user.username }}</p>
                        {# <span class="text-yellow font-bold text-lg">
                            {{ user.num_questions }}&nbsp;
                        </span>
                        <p>
                            question{% if user.num_questions > 1 %}s{% endif %}
                        </p> #}
                        {% if user.imageNameUser == null %}
                            <img class="image_user w-16 h-16 rounded-full" src="{{ asset('media/pdp_default.jpg') }}">
                        {% else %}
                            <img class="image_user w-16 h-16 rounded-full" src="{{ vich_uploader_asset(user, 'imageFileUser') }}">        
                        {% endif %}
                    </div>
                </a>
            {% endfor %}
        </section>
        {% include "components/footer.html.twig" %}
    </div>
{% endblock %}
