{% extends 'base.html.twig' %}

{% block title %}Livequestion - Accueil{% endblock %}

{% block body %}
    {% include "components/header.html.twig" %}

    <div class="m-12">
        {#}Section Last Question{#}
        <section class="last-question flex mb-24 w-full">
            {% for question in lastQuestion %}
            <div class="w-full">
                <div class="grid lg:flex">
                    {% if question.imageNameQuestion == null %}
                        <img class="image_question rounded-2xl w-full shadow-md" src="{{ asset('media/image_question_default.jfif') }}">
                    {% else %}
                        <img class="image_question rounded-2xl w-full shadow-md" src="{{ vich_uploader_asset(question, 'imageFileQuestion') }}">        
                    {% endif %}
                    <div>
                        <div class="grid ml-12 h-full lg:h-3/4 mt-4">
                            <div class="flex gap-4 items-center">
                                <p class="font-bold text-lg">{{ question.thematicId.name }}</p>
                                <span>•</span>
                                <p>Il y a {{ question.getTimeElapsed() }}</p>
                            </div>
                            <h1 class="font-semibold text-4xl">{{ question.title }}</h1>
                            {% include "components/createdByAndNbAnswerBigFont.html.twig" %}
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </section>
        {#}Section Last Question{#}


        {#}Section Three Last Question{#}
        <section class="container-three-last-questions mb-24">
            <div class="flex justify-between mb-8">
                <h1 class="font-semibold text-4xl">Dernières questions</h1>
                <a href="{{ path('question') }}" class="text-rose">Voir toutes les questions</a>
            </div>
            <div class="justify-between gap-36 xl:flex grid grid-cols-2">
                {% for question in threeLastQuestion %}
                    {% include "components/containerLittleQuestion.html.twig" %}
                {% endfor %}
            </div>
        </section>
        {#}Section Three Last Question{#}


        {#}Section Best Author{#}
        <section class="container-best-author mb-24">
            <div class="flex justify-between">
                <h1 class="font-semibold text-4xl">Meilleurs auteurs</h1>
                <a href="{{ path('auteur') }}" class="text-rose">Voir tous les auteurs</a>
            </div>
            <div class="grid justify-between mt-6 mb-6 xl:flex grid-cols-3 gap-6 lg:justify-left ">
                {% for bestUser in fiveBestUser %}
                    {% include "components/bestAuthor.html.twig" %}
                {% endfor %}
            </div>
        </section>
        {#}Section Best Author{#}


        {#}Section random question same thematic{#}
        <section class="container-three-random-question-same-thematic mb-24">
            <div class="flex justify-between mb-8">
                <h1 class="font-semibold text-4xl">Dans la thématique "{{ thematicSport.name }}"</h1>
                <a href="{{ path('question', {'thematicName': thematicSport.id}) }}" class="text-rose">Voir d’autres questions sur "{{ thematicSport.name }}"</a>
            </div>
            <div class="flex justify-between gap-36 xl:flex grid grid-cols-2">
                {% for question in threeQuestionsWithThematicSport %}
                    {% include "components/containerLittleQuestion.html.twig" %}
                {% endfor %}
            </div>
        </section>
        {#}Section random question same thematic{#}
        

        {#}Section Random Question{#}
        <section class="container-three-random-question">
            <h1 class="font-semibold text-4xl mb-8">Questions aléatoires</h1>
            <div class="three-random-question flex gap-28">
                <div class="big-question w-3/6">
                {% for question in bigRandomQuestion %}
                    {% include "components/containerLittleQuestion.html.twig" %}
                {% endfor %}
                </div>
                <div class="two-little-question w-3/12">
                {% for question in twoLittleRandomQuestion %}
                    {% include "components/containerLittleQuestion.html.twig" %}
                {% endfor %}
                </div>
            </div>
        </section>
        {#}Section Random Question{#}
        <div class="gap-8 grid ">
            {% include "components/footer.html.twig" %}
        </div>
    </div>

{% endblock %}
