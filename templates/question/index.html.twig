{% extends 'base.html.twig' %}

{% block title %}Livequestion - Questions{% endblock %}

{% block body %}
    {% include "components/header.html.twig" %}

    <div class="m-12">
        <h1 class="font-semibold text-4xl">Les questions</h1>
        <p>Filtrer les résultats</p>
        <div class="filtre">
            <form action="{{ path('question') }}" method="get" class="mb-14 ">
                <div class="input-group content-rechercher xl:flex md:justify-between mb-14 md:grid md:grid-cols-repeat-2">
                    <div class="info-search w-full">
                        <div class="info-search w-full">
                            <span>
                                Titre de la question
                            </span>
                            <input type="text" name="title">
                        </div>
                        <span>
                            Auteur :
                        </span>
                        <select name="authorName">
                            <option></option>
                            {% for user in users %}
                                <option value="{{ user.id }}">{{ user.username }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="info-search w-full">
                        <span>
                            Catégorie :
                        </span>
                        <select name="thematicName">
                            <option></option>
                            {% for thematic in thematics %}
                                <option value="{{ thematic.id }}">{{ thematic.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="flex items-end justify-center">
                        <button class="btn" type="submit">
                            Rechercher
                        </button>
                    </div>
                </div>
            </form>
        </div>
        <div class="container-question grid gap-16">
            {% if totalQuestionFound == 0 %}
                <p>Aucune question trouvée.</p>
            {% elseif questions is defined %}
                {% for question in questions %}
                    {% include "components/question.html.twig" %}
                {% endfor %}
            {% endif %}
        </div>
    </div>
    {% if questions is not empty %}
        {% if questions is defined %}
            {% include "components/pagination.html.twig" with {
                route: 'question',
                currentPage,
                countPages
            } only %}
        {% endif %}
    {% endif %}
{% endblock %}