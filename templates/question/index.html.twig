{% extends 'base.html.twig' %}

{% block title %}Livequestion - Questions{% endblock %}

{% block body %}
    {% include "components/header.html.twig" %}

    <div class="m-12">
        <h1 class="font-semibold text-4xl mb-12">Les questions</h1>
        <p class="text-xl font-bold text-grey-black mb-3">Filtrer les résultats</p>
        <div class="filtre p-5 rounded-lg border-2 mb-28">
            <form action="{{ path('question') }}" method="get" class="">
                <div class="input-group content-rechercher">
                    <div class="info-search w-full grid mb-3">
                        <span class="mb-2 font-semibold text-lg">
                            Titre de la question
                        </span>
                        <input class="border-2 rounded-lg py-2.5 px-3.5" type="text" name="title">
                    </div>
                    <div class="info-search w-full sm:flex gap-5">
                        <div class="author w-full grid sm:w-3/6">
                            <span class="mb-2 font-semibold text-lg">
                                Auteur :
                            </span>
                            <select class="border-2 rounded-lg py-2.5 px-3.5" name="authorName">
                                <option>Sélectionner un auteur</option>
                                {% for user in users %}
                                    <option value="{{ user.id }}">{{ user.username }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="thematic w-full grid sm:w-3/6">
                            <span class="mb-2 font-semibold text-lg">
                                Catégorie :
                            </span>
                            <select class="border-2 rounded-lg py-2.5 px-3.5" name="thematicName">
                                <option>Sélectionner une catégorie</option>
                                {% for thematic in thematics %}
                                    <option value="{{ thematic.id }}">{{ thematic.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="flex items-end justify-center">
                        <button class="btn" type="submit">
                            rechercher
                        </button>
                    </div>
                </div>
            </form>
        </div>
        <div class="container-question grid gap-16">
            {% if totalQuestionFound == 0 %}
                <p>Aucune question trouvée.</p>
            {% elseif questions is defined %}
                {% for question in questions %}
                    {% include "components/question.html.twig" %}
                {% endfor %}
            {% endif %}
        </div>
    </div>
    {% if questions is not empty %}
        {% if questions is defined %}
            {% include "components/pagination.html.twig" with {
                route: 'question',
                currentPage,
                countPages
            } only %}
        {% endif %}
    {% endif %}
{% endblock %}